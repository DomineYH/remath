# 서버 변수 이름만(값 없음). 실제 값은 저장소 밖의 파일·셸에 둔다. 설명·기본값: README "운영 › 환경변수".
# 복사해 쓸 때 쓰지 않는 변수는 줄째 지운다: `KEY=` 빈 줄은 빈 문자열이라 기본값이 아니고 검증에 걸린다.

# ---- 서버 런타임 env 파일(REMATH_ENV_FILE, 600) — 로컬 개발이면 server/.env (npm run dev -w server)
# SUPABASE_* 4줄은 deploy.sh·restore.sh 가 스모크 통과 뒤 써 넣는다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
SUPABASE_ANON_KEY=
# 0 = 실 공급자(KEY_VAULT_SECRET 필수), 1 = 목. 그 밖의 값은 기동 실패.
MOCK_LLM=
MAX_TURNS=
TURN_TIMEOUT_MS=
# 실서버는 미설정. HTTP 스테이징·개발만 false.
COOKIE_SECURE=
BACKUP_DIR=
BACKUP_KEEP=
BACKUP_AT=
# 로컬 개발만. 컨테이너 env 파일에는 넣지 않는다(호스트 포트 = REMATH_PORT).
PORT=
# 키 금고 비밀(MOCK_LLM=0 이면 필수): openssl rand -base64 32. 바꾸면 모든 키를 다시 등록한다. 백업에 없다.
KEY_VAULT_SECRET=

# ---- 운영자 셸만(서버 컨테이너에 넣지 않는다)
ADMIN_INITIAL_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# 조직 slug
SUPABASE_ORG_ID=
SUPABASE_REGION=
SUPABASE_DB_PASSWORD=
REMATH_ENV_FILE=
REMATH_IMAGE=
REMATH_BIND=
REMATH_PORT=
REMATH_BACKUP_DIR=
