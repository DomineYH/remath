# 변수 이름만(값 없음). 실제 값은 저장소 밖의 파일·셸에 둔다. 설명·기본값·어디에 두는지: README "운영 › 환경변수".
# 복사해 쓸 때 쓰지 않는 변수는 줄째 지운다: `KEY=` 빈 줄은 빈 문자열이라 기본값이 아니고 검증에 걸린다(deploy.sh 도 거절한다).

# ---- production 런타임 env 파일(REMATH_ENV_FILE, 저장소 밖, 600) — deploy.sh 가 읽어 Vercel Production env 에 넣는다(고치지 않는다)
# 0 = 실 공급자(KEY_VAULT_SECRET 필수), 1 = 목. 그 밖의 값은 기동 실패. production 은 0.
MOCK_LLM=
# 키 금고 비밀(MOCK_LLM=0 이면 필수): openssl rand -base64 32. 바꾸면 모든 키를 다시 등록한다. 백업에 없다.
KEY_VAULT_SECRET=
# 백업 크론(GET /api/cron/backup)의 Bearer 비밀. 필수: Vercel Production 에 이미 있는 값과 같게.
CRON_SECRET=
# 선택(없으면 40 · 120000 · 7)
MAX_TURNS=
TURN_TIMEOUT_MS=
BACKUP_KEEP=
# SUPABASE_* 는 이 파일에 두지 않는다: deploy.sh 가 셸(또는 --new 의 새 프로젝트)에서 받아 Vercel 에 쓴다.
# COOKIE_SECURE·PORT·BACKUP_DIR 는 production 에 넣지 않는다(HTTPS, Vercel 함수).

# ---- 운영자 셸만(Vercel·서버에 넣지 않는다). SUPABASE_* 4개는 deploy.env(600)에 적어 두고 셸로 읽는다(README).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# psql 연결(Session pooler 5432). DB 비밀번호가 들어 있다: Vercel 에 넣지 않는다.
SUPABASE_DB_URL=
SUPABASE_ANON_KEY=
ADMIN_INITIAL_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# 조직 slug
SUPABASE_ORG_ID=
SUPABASE_REGION=
SUPABASE_DB_PASSWORD=
# production 런타임 env 파일(위)의 경로
REMATH_ENV_FILE=

# ---- 로컬 개발(server/.env, npm run dev -w server): server/.env.example
