# Copy to server/.env (git-ignored) for `npm run dev -w server` (local single process, src/index.ts). Never commit real values.
# Production runs on Vercel; its env is set by scripts/deploy.sh (README "운영").
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Local dev uses the mock LLM (O-6). 0 needs KEY_VAULT_SECRET (openssl rand -base64 32).
MOCK_LLM=1
# Optional: MAX_TURNS=40, TURN_TIMEOUT_MS=120000, PORT=3000.
# Dev over plain HTTP only; never in production (= true, O-10).
COOKIE_SECURE=false
# Optional local backup CLI (H-30): BACKUP_DIR=backup (relative to server/), BACKUP_KEEP=7 files (CLI and the backup cron).
# Backup cron GET /api/cron/backup (V9): Bearer secret. Unset or empty = always 401.
CRON_SECRET=
