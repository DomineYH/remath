# Copy to server/.env (git-ignored) for `npm run dev -w server`. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Stage 2 runs only with MOCK_LLM=1 (O-6).
MOCK_LLM=1
# Optional: MAX_TURNS=40, TURN_TIMEOUT_MS=120000, PORT=3000.
# Dev over plain HTTP only; production leaves it unset (= true, O-10).
COOKIE_SECURE=false
# Optional SQLite backup (H-30): BACKUP_DIR=backup (relative to server/; in the container keep it so it hits the volume),
# BACKUP_KEEP=7 files, BACKUP_AT=03:00 (HH:MM, server local time).
