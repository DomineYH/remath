{
  "name": "@remath/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "admin:reset-password": "node src/cli/reset-password.ts",
    "dev": "node --env-file=.env --import ./src/raw-hooks.ts --watch src/index.ts",
    "start": "node --import ./src/raw-hooks.ts src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate": "node --import ./src/raw-hooks.ts src/cli/migrate.ts",
    "db:seed": "node --import ./src/raw-hooks.ts src/cli/seed.ts",
    "db:smoke": "node --import ./src/raw-hooks.ts src/cli/smoke.ts",
    "env:swap": "node --import ./src/raw-hooks.ts src/cli/env-swap.ts",
    "test:http": "vitest run --config vitest.http.config.ts",
    "backup": "node --import ./src/raw-hooks.ts src/cli/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@remath/prompts": "*",
    "@remath/shared": "*",
    "@supabase/supabase-js": "^2.118.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/better-sqlite3": "^9.6.0"
  }
}
