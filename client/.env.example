# Keys only — put real values in client/.env.development.local (git-ignored).
# Mock mode is for local dev and CI only. Never deploy a mock build (npm run check:bundle guards prod builds).
VITE_MOCK_API=
# Initial admin password for the mock. Must satisfy the password rule (8+ chars, letters and numbers, no spaces),
# otherwise admin login is impossible. Unset or empty = every admin login fails with 401.
VITE_MOCK_ADMIN_PASSWORD=
